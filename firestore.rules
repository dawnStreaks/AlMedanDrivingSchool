rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{reviewId} {
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 100;
      allow create: if request.resource.data.keys().hasAll(['name', 'rating', 'review', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'rating', 'review', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.review is string
        && request.resource.data.review.size() > 0
        && request.resource.data.review.size() <= 1000
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
